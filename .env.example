# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Vultr Serverless Inference (OpenAI-compatible) ---
AR_VULTR_BASE=https://api.vultrinference.com/v1
AR_VULTR_KEY=
# Model id is NOT guessed here on purpose. Run `python3 models/smoke_test.py --list`
# after the kickoff, pick the id that matches GLM 5.2 in the catalog, then set it.
AR_MODEL=

# --- Sandbox limits (see sandbox/run.sh) ---
AR_MEM=512m
AR_CPUS=1
AR_PIDS=64
AR_TMPFS_MB=64
AR_TIMEOUT_S=120

# --- Egress proxy (deny by default) ---
AR_PROXY_PORT=8899
AR_PROXY_LOG=work/egress.jsonl
# comma separated; empty = deny everything
AR_ALLOW=

# --- Web/API (built in the event window) ---
AR_PORT=8080
